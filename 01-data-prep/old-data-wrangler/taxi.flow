{
  "metadata": {
    "version": 1,
    "disable_limits": false,
    "instance_type": "ml.m5.4xlarge",
    "_comment": "Data Wrangler flow SCAFFOLD for the NYC taxi demo. Import this into Studio Classic / Canvas Data prep as a starting point, then add the remaining transforms from PIPELINE_SPEC.md live. Operator names follow the Data Wrangler schema; node UUIDs are illustrative."
  },
  "nodes": [
    {
      "node_id": "src-trips-0001",
      "type": "SOURCE",
      "operator": "sagemaker.s3_source_0.1",
      "parameters": {
        "dataset_definition": {
          "datasetSourceType": "S3",
          "name": "yellow_tripdata_2024-01.parquet",
          "s3ExecutionContext": {
            "s3Uri": "s3://roi-smdemo-029331796573-us-east-2/raw/trips/yellow_tripdata_2024-01.parquet",
            "s3ContentType": "parquet",
            "s3HasHeader": true
          }
        }
      },
      "inputs": [],
      "outputs": [{ "name": "default" }]
    },
    {
      "node_id": "infer-types-0002",
      "type": "TRANSFORM",
      "operator": "sagemaker.spark.infer_and_cast_type_0.1",
      "parameters": {},
      "inputs": [{ "name": "df", "node_id": "src-trips-0001", "output_name": "default" }],
      "outputs": [{ "name": "default" }],
      "_comment": "Data Wrangler infers a schema on its ~50k-row sample here."
    },
    {
      "node_id": "drop-missing-0003",
      "type": "TRANSFORM",
      "operator": "sagemaker.spark.handle_missing_0.1",
      "parameters": {
        "operator": "Drop missing",
        "drop_missing_parameters": {
          "dimension": "Drop Rows",
          "input_column": ["tpep_pickup_datetime", "tpep_dropoff_datetime", "PULocationID", "DOLocationID"]
        }
      },
      "inputs": [{ "name": "df", "node_id": "infer-types-0002", "output_name": "default" }],
      "outputs": [{ "name": "default" }],
      "_comment": "T2 from PIPELINE_SPEC. Add T3-T15 as further TRANSFORM nodes; add a second S3 SOURCE for taxi_zone_lookup.csv and a sagemaker.spark.join_0.1 node for T14."
    }
  ]
}
